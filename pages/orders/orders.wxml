<view class="page history"><view class="section-title">🧾 闪电订单簿｜</view><view class="muted subtitle">新订单自动同步云端。</view><view wx:if="{{orders.length===0}}" class="empty"><text class="empty-icon">🧾</text>{{loadMessage || '还没有订单，第一份心意等你点！'}}</view><view wx:for="{{orders}}" wx:key="id" class="order-card cream-card" data-id="{{item.id}}" bindtap="open"><view class="order-head"><text>{{item.time}}</text><text>{{item.statusLabel}} →</text></view><view class="order-summary">{{item.summary}}</view><view class="order-foot"><text>{{item.lines.length}} 种心意</text><text>⚡ {{item.total}}</text></view></view></view>
