.chef-page{padding-bottom:50rpx}.chef-hero{background:linear-gradient(135deg,#ffdc79,#fff0cc);padding:40rpx 28rpx 32rpx}.kicker{font-size:21rpx;color:#ad713a;font-weight:800}.title{font-size:39rpx;font-weight:900;margin:13rpx 0}.subtitle{font-size:23rpx;color:#8d6e50}.back{display:inline-block;margin-top:20rpx;background:#fff8df;padding:10rpx 18rpx;border-radius:99rpx;color:#8c6034;font-size:22rpx}.chef-shortcuts{display:flex;gap:16rpx;padding:20rpx 24rpx}.chef-shortcuts .cream-card{flex:1;padding:19rpx;font-weight:800}.chef-shortcuts text{font-size:37rpx;display:block}.chef-shortcuts .shortcut-count{font-size:21rpx;color:#a79685;font-weight:400}.local-note{margin:0 24rpx;background:#eaf5f7;padding:18rpx;border-radius:17rpx;font-size:21rpx;color:#607c85;line-height:1.5}.list-title{margin:27rpx 24rpx 17rpx}.chef-cats{white-space:nowrap;padding:0 24rpx 18rpx}.chef-cat{display:inline-block;background:#fff0d5;border-radius:99rpx;margin-right:12rpx;padding:13rpx 20rpx;color:#8d765f;font-size:23rpx}.chef-cat.active{background:#ffce4e;color:#493727;font-weight:900}.chef-dish{display:flex;gap:18rpx;margin:0 24rpx 15rpx;padding:15rpx;align-items:center}.chef-dish image{width:115rpx;height:115rpx;border-radius:14rpx}.dish-name{font-weight:800;font-size:27rpx}.chef-dish .muted{font-size:20rpx;margin:6rpx 0}.view-recipe{color:#d58339;font-size:20rpx;font-weight:700}

/* Long dish names must wrap instead of pushing the card beyond the screen. */
.chef-dish image{flex:none}
.chef-dish>view{flex:1;min-width:0}
.dish-name{overflow-wrap:break-word}

.chef-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}
.chef-gate{margin:40rpx 24rpx;padding:32rpx;text-align:center}.chef-gate view:first-child{font-size:32rpx;font-weight:800}.chef-gate text{display:block;margin:20rpx 0;color:#8d765f}.chef-gate button{margin:24rpx 0}.chef-empty{margin:0 24rpx 18rpx;color:#a79685}.chef-order,.chef-detail{margin:0 24rpx 15rpx;padding:22rpx}.chef-order-head{display:flex;justify-content:space-between;color:#9b8e83;font-size:22rpx}.chef-order-head .status{color:#d58339;font-weight:800}.chef-order-summary{font-weight:800;margin:12rpx 0}.chef-order .muted,.chef-detail .muted{font-size:21rpx}.chef-line{display:flex;justify-content:space-between;border-bottom:1rpx solid #f3e9de;padding:13rpx 0}.chef-note{font-size:23rpx;line-height:1.6;margin-top:10rpx;word-break:break-all}.chef-action{margin-top:20rpx}
