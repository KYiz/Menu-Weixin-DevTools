<view class="page chef-page">
  <view wx:if="{{!authorized}}" class="chef-gate cream-card">
    <view>{{loading ? '👨‍🍳 正在验证主厨身份…' : '🔒 主厨入口'}}</view>
    <text wx:if="{{!loading}}">{{accessError}}</text>
    <button wx:if="{{!loading}}" class="btn" bindtap="refreshOrders">重新检查</button>
    <view class="back" bindtap="guest">← 返回点餐入口</view>
  </view>
  <block wx:else>
    <view class="chef-hero">
      <view class="kicker">👨‍🍳 CHEF MODE · 闪电厨房</view>
      <view class="title">欢迎回来，闪电主厨！</view>
      <view class="subtitle">围裙系好，今天也为她认真做饭。</view>
      <view class="back" bindtap="guest">← 返回点餐入口</view>
    </view>
    <view class="chef-shortcuts">
      <view class="cream-card" bindtap="refreshOrders"><text>🧾</text><view>云端订单 · 刷新</view><text class="shortcut-count">{{loading ? '读取中' : orderCount + ' 份'}}</text></view>
      <view class="cream-card" bindtap="favorites"><text>💛</text><view>本机收藏</view><text class="shortcut-count">{{favCount}} 项</text></view>
    </view>
    <view class="local-note">订单从云端读取。点开订单查看备注和菜品，再按顺序处理。</view>
    <view class="section-title list-title">🧾 接单管理</view>
    <view wx:if="{{!orders.length}}" class="chef-empty">{{loading ? '正在读取订单…' : '暂时没有新订单'}}</view>
    <view wx:for="{{orders}}" wx:key="key" class="chef-order-group" id="chef-order-{{index}}">
      <view class="chef-order cream-card" data-key="{{item.key}}" data-index="{{index}}" bindtap="chooseOrder">
        <view class="chef-order-head"><text>{{item.time}}</text><text class="status">{{item.statusLabel}}</text></view>
        <view class="chef-order-summary">{{item.summary}}</view>
        <view class="muted">{{item.diningModeLabel}} · {{item.id}} · ⚡ {{item.total}}</view>
      </view>
      <view wx:if="{{selectedKey === item.key}}" class="chef-detail cream-card">
        <view class="section-title">订单详情</view>
        <view class="muted">{{item.time}} · {{item.id}}</view>
        <view class="chef-note">用餐方式：{{item.diningModeLabel}}</view>
        <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="chef-line">
          <text>{{line.name}} × {{line.qty}}</text><text>⚡ {{line.price * line.qty}}</text>
        </view>
        <view class="chef-note">口味：{{item.taste || '无'}}</view>
        <view class="chef-note">备注：{{item.note || '无'}}</view>
        <view class="chef-note">状态：{{item.statusLabel}}</view>
        <button wx:if="{{item.nextStatus}}" class="btn chef-action" disabled="{{updating}}" bindtap="advanceStatus">{{updating ? '更新中…' : item.actionLabel}}</button>
      </view>
    </view>
    <view class="section-title list-title">📒 全部菜谱与服务</view>
    <scroll-view scroll-x="true" class="chef-cats">
      <view wx:for="{{categories}}" wx:key="id" class="chef-cat {{selected===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tapCategory">{{item.emoji}} {{item.short}}</view>
    </scroll-view>
    <view wx:for="{{visible}}" wx:key="id" class="chef-dish cream-card" data-id="{{item.id}}" bindtap="open">
      <image src="{{item.image}}" mode="aspectFill"/>
      <view><view class="dish-name">{{item.name}}</view><view class="muted">{{item.type==='dish'?item.minutes+' 分钟 · '+item.difficulty+' 星难度':'情侣专属服务 · 无需菜谱'}}</view><view class="view-recipe">{{item.type==='dish'?'查看完整菜谱 →':'查看服务详情 →'}}</view></view>
    </view>
  </block>
</view>
