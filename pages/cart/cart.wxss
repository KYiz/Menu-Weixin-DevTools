.cart-page{padding:28rpx 24rpx 170rpx}.top{margin-bottom:24rpx}.top .muted{font-size:23rpx;margin-top:8rpx}.items,.prefs{padding:20rpx;margin-bottom:22rpx}.line{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-bottom:2rpx dashed #f0e7db}.line:last-child{border:0}.line image{width:128rpx;height:128rpx;border-radius:17rpx;background:#ffeeca}.line-main{flex:1;min-width:0}.line-name{font-weight:800;font-size:27rpx}.line-type{font-size:20rpx;margin:8rpx 0}.line-price{color:#ed7840;font-weight:800}.line-actions{display:flex;flex-direction:column;align-items:flex-end;gap:17rpx}.remove{font-size:20rpx;color:#aaa}.counter{display:flex;align-items:center;gap:17rpx}.counter text:first-child,.counter text:last-child{width:40rpx;height:40rpx;display:flex;justify-content:center;align-items:center;background:#ffdf79;border-radius:50%;font-weight:900}.label{font-size:25rpx;font-weight:700;margin:25rpx 0 12rpx}.radios{display:flex;flex-wrap:wrap;gap:17rpx}.radios label{font-size:22rpx;display:flex;align-items:center}.radios radio{transform:scale(.72);margin-right:-10rpx}.prefs textarea{width:100%;min-height:155rpx;background:#fff8e9;border-radius:18rpx;padding:18rpx;font-size:24rpx}.hint{text-align:center;color:#a99685;font-size:21rpx}.checkout{display:flex;justify-content:space-between;align-items:center}.sum{font-weight:900;color:#ed7840;font-size:29rpx}.checkout .muted{font-size:20rpx}.checkout .btn[disabled]{opacity:.55}.empty .btn{margin:25rpx auto;width:250rpx}

.line image,.line-actions{flex:none}
.line-name{overflow-wrap:break-word}
.dining-modes{gap:28rpx;padding:8rpx 0 4rpx}

.cart-page{background:#fff7f3;color:#63343e}
.top .section-title,.items .section-title,.prefs .section-title{color:#653341}
.items,.prefs{background:#fffdfb;border:2rpx solid #fbe0e6}
.line{border-bottom-color:#f1dce2}
.line-price,.sum{color:#ef5d7e}
.line-qty{flex:none;padding:7rpx 12rpx;border-radius:99rpx;background:#ffe9ef;color:#c75c7a;font-size:23rpx;font-weight:800}
.checkout .btn{background:linear-gradient(180deg,#ff9caf,#f4587d);color:#fff}

