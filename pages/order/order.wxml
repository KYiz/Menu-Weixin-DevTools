<view class="page order-detail" wx:if="{{order}}">
  <view class="order-hero">
    <view class="hero-bubble bubble-left"></view>
    <view class="hero-bubble bubble-right"></view>
    <view class="hero-kicker">🍓 小霞饱饱食堂 · 心动订单</view>
    <view class="hero-icon">💗</view>
    <view class="hero-status">{{order.statusLabel}}</view>
    <view class="hero-message" wx:if="{{stale}}">暂时无法更新 · 显示上次确认的状态</view>
    <view class="hero-message" wx:elif="{{syncState==='failed'}}">订单暂存本机，等待同步云端</view>
    <view class="hero-message" wx:else>{{order.statusMessage}}</view>
  </view>

  <view class="progress cream-card">
    <view class="card-heading"><text class="heading-heart">♥</text><text>订单进度</text><text class="heading-bolt">⚡</text></view>
    <view wx:for="{{steps}}" wx:key="status" class="progress-step {{item.reached?'reached':''}} {{item.current?'current':''}}">
      <view class="progress-marker"><text class="progress-dot">{{item.reached?'♥':'○'}}</text><view wx:if="{{index!==steps.length-1}}" class="progress-line"></view></view>
      <text class="progress-label">{{item.label}}</text>
      <text wx:if="{{item.current}}" class="current-tag">进行中</text>
    </view>
  </view>
  <button class="refresh-status" bindtap="refreshStatus" disabled="{{refreshing}}">{{refreshing?'刷新中…':'↻ 刷新状态'}}</button>

  <view class="paper cream-card">
    <view class="paper-header">
      <view class="paper-title">小霞饱饱食堂 <text>⚡</text></view>
      <view class="paper-sub">{{order.diningModeLabel}} · 订单详情</view>
    </view>
    <view class="meta">
      <view>订单编号：{{order.id}}</view>
      <view>订单时间：{{order.time}}</view>
      <view>用餐方式：{{order.diningModeLabel}}</view>
      <view>订单状态：{{order.statusLabel}}</view>
    </view>
    <view class="divider"></view>
    <view class="label">🍽 点餐内容</view>
    <view wx:for="{{food}}" wx:key="id" class="entry"><text>{{item.name}} × {{item.qty}}</text><text>⚡ {{item.price*item.qty}}</text></view>
    <view class="label" wx:if="{{service.length}}">💗 特殊服务</view>
    <view wx:for="{{service}}" wx:key="id" class="entry"><text>{{item.name}} × {{item.qty}}</text><text>⚡ 0</text></view>
    <view class="divider"></view>
    <view class="note">口味偏好：{{order.taste||'无'}}</view>
    <view class="note">备注：{{order.note||'无'}}</view>
    <view class="total">合计 <text>⚡ {{order.total}}</text></view>
  </view>

  <view class="sync-note" wx:if="{{syncMessage}}">{{syncMessage}}</view>
  <button wx:if="{{syncState==='failed'}}" class="sync-retry" bindtap="syncOrder">重试同步云端</button>
  <view class="send-tip">云端同步成功后，主厨进入接单页面即可查看。也可以复制订单，通过微信聊天发送。</view>
  <button class="copy" bindtap="copy">📋 复制完整订单</button>
  <button class="share" open-type="share">分享小程序给主厨</button>
  <button class="again" bindtap="reorder">再来一单 →</button>
</view>
