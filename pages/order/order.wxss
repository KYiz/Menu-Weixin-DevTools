.order-detail{padding:20rpx 25rpx 60rpx}.success{text-align:center;font-size:65rpx;margin:25rpx 0 27rpx}.success view{font-size:40rpx;font-weight:900}.success text{font-size:23rpx;color:#b68772}.paper{padding:33rpx}.paper-title{text-align:center;font-size:35rpx;font-weight:900}.paper-sub{text-align:center;color:#d6803b;font-size:23rpx;margin:5rpx 0 26rpx}.meta{font-size:21rpx;color:#a28e7d;line-height:1.7}.divider{border-top:2rpx dashed #e8d9c6;margin:23rpx 0}.label{font-weight:800;margin:17rpx 0 12rpx}.entry{display:flex;justify-content:space-between;padding:8rpx 0;font-size:25rpx}.note{color:#7c6a5f;line-height:1.6;font-size:23rpx}.total{text-align:right;color:#ed7d3d;font-weight:900;font-size:32rpx;margin-top:25rpx}.send-tip{background:#fff1d3;color:#9c6f40;padding:20rpx;border-radius:17rpx;font-size:22rpx;line-height:1.6;margin:24rpx 0}.copy,.share{width:100%;margin-bottom:14rpx}.again{text-align:center;color:#a66d40;padding:18rpx;font-size:25rpx}
.sync-note{margin:20rpx 0;color:#8c6034;font-size:23rpx;line-height:1.5;word-break:break-all}.sync-retry{margin-bottom:16rpx}
.progress{padding:24rpx 32rpx;margin-bottom:18rpx;background:#fff5f7}.progress .section-title{margin-bottom:15rpx}.progress-step{display:flex;align-items:center;gap:16rpx;padding:9rpx 0;color:#b5a7a5;font-size:24rpx}.progress-step.reached{color:#d96b89}.progress-step.current{font-weight:900;color:#a64b69}.progress-dot{width:30rpx;text-align:center}.refresh-status{width:100%;margin-bottom:18rpx}
