.recipe-page{padding-bottom:170rpx}.recipe-cover{width:100%;height:370rpx;background:#fff0d5}.recipe-head{padding:25rpx 27rpx}.kicker{color:#d98a42;font-size:22rpx;font-weight:800}.recipe-name{font-size:42rpx;font-weight:900;margin:12rpx 0}.recipe-head .muted{line-height:1.6;font-size:24rpx}.stats{display:flex;justify-content:space-between;background:#fff0d3;border-radius:20rpx;padding:18rpx 15rpx;margin-top:23rpx;text-align:center;color:#9a6133;font-weight:800;font-size:24rpx}.stats text{display:block;font-size:18rpx;color:#aa8e73;font-weight:400;margin-top:4rpx}.recipe-section{margin:0 24rpx 18rpx;padding:23rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:6rpx}.section-head .section-title{font-size:30rpx}.people{display:flex;gap:5rpx}.people text{font-size:20rpx;color:#987b5e;background:#fff3d9;border-radius:99rpx;padding:7rpx 11rpx}.people .picked{background:#ffcd4a;color:#4c3523;font-weight:800}.scale-note{font-size:19rpx;color:#a99483;margin:15rpx 0}.subhead{font-weight:800;color:#a36e3e;margin:21rpx 0 7rpx;font-size:23rpx}.measure{display:flex;justify-content:space-between;padding:11rpx 0;border-bottom:1rpx dashed #eee4d7;font-size:24rpx}.measure text:last-child{font-weight:800}.body-text{line-height:1.7;color:#665449;font-size:24rpx;margin-top:12rpx}.step{display:flex;gap:16rpx;border-bottom:2rpx dashed #eee1d4;padding:20rpx 0}.step:last-child{border:0}.step-number{height:44rpx;width:44rpx;display:flex;align-items:center;justify-content:center;flex:none;border-radius:50%;background:#ffcd4a;color:#6c4a23;font-weight:900}.step-title{font-size:27rpx;font-weight:900}.step-meta{color:#e08645;font-size:21rpx;margin:8rpx 0}.step-uses{font-size:20rpx;color:#a38c79;background:#fff8e7;padding:10rpx 13rpx;border-radius:12rpx;margin-top:13rpx}.mini-label{font-size:23rpx;color:#a76938;font-weight:800;margin-top:20rpx}.start{width:100%}
