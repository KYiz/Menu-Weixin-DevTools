<view class="page recipe-page" wx:if="{{recipe}}"><image class="recipe-cover" src="{{item.image}}" mode="aspectFill"/><view class="recipe-head"><view class="kicker">📒 闪电主厨的手写菜谱</view><view class="recipe-name">{{item.name}}</view><view class="muted">{{recipe.intro}}</view><view class="stats"><view>⭐ {{recipe.difficulty}} 星<text>制作难度</text></view><view>⏱ {{recipe.prepMinutes}} 分<text>准备时间</text></view><view>🍳 {{recipe.cookMinutes}} 分<text>烹饪时间</text></view></view></view><view class="recipe-section cream-card"><view class="section-head"><view class="section-title">🥕 食材清单</view><view class="people"><text wx:for="{{servingChoices}}" wx:key="*this" class="{{servings===item?'picked':''}}" data-n="{{item}}" bindtap="choose">{{item}}人</text></view></view><view class="scale-note">默认 2 人份；用量按比例换算，火候与时间保持原说明。</view><view class="subhead">主食材</view><view wx:for="{{ingredients}}" wx:key="name" class="measure"><text>{{item.name}}</text><text>{{item.displayAmount}} {{item.unit}}</text></view><view class="subhead">调味料</view><view wx:for="{{seasonings}}" wx:key="name" class="measure"><text>{{item.name}}</text><text>{{item.displayAmount}} {{item.unit}}</text></view></view><view class="recipe-section cream-card"><view class="section-title">🔪 开始前先准备</view><view class="body-text">{{recipe.prep}}</view></view><view class="recipe-section cream-card"><view class="section-title">🍳 一步一步来</view><view wx:for="{{recipe.steps}}" wx:key="number" class="step"><view class="step-number">{{item.number}}</view><view class="step-body"><view class="step-title">{{item.title}}</view><view class="step-meta">🔥 {{item.heat}}　⏱ 约 {{item.minutes}} 分钟</view><view class="body-text">{{item.text}}</view><view class="step-uses">这步用到：{{item.uses}}</view></view></view></view><view class="recipe-section cream-card"><view class="section-title">✨ 主厨的小提醒</view><view class="mini-label">火候控制</view><view class="body-text">{{recipe.heatControl}}</view><view class="mini-label">关键时间</view><view class="body-text">{{recipe.keyTiming}}</view><view class="mini-label">容易失败的地方</view><view class="body-text">{{recipe.tips}}</view><view class="mini-label">装盘建议</view><view class="body-text">{{recipe.plating}}</view></view><view class="sticky-actions"><button class="btn start" bindtap="start">开始做菜 ⚡</button></view></view>
