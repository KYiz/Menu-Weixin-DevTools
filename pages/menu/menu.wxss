-emoji{font-size:31rpx}.cat.active{color:#262626;background:#fff;border-left-color:#ffce35}.dish-list{height:100%;padding:10rpx 17rpx 24rpx}.group-title{font-size:23rpx;color:#888;margin:6rpx 0 10rpx}.dish-card{display:flex;min-height:174rpx;border-bottom:2rpx solid #f2f2f2;padding:10rpx 0;gap:14rpx}.dish-img{width:142rpx;height:142rpx;border-radius:9rpx;flex:none;background:#fff3d9}.dish-info{flex:1;min-width:0}.dish-name{font-size:27rpx;font-weight:900;line-height:1.25;color:#282828}.dish-desc{font-size:20rpx;color:#999;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:8rpx}.dish-meta{font-size:18rpx;color:#aaa;margin-top:8rpx}.dish-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:8rpx}.price{font-size:24rpx;color:#ef514c;font-weight:700}.small-add{background:#ffd343;color:#4d3b1e;font-size:19rpx;font-weight:800;border-radius:7rpx;padding:7rpx 14rpx;line-height:1.3;margin:0}.sticky-actions{background:linear-gradient(transparent,rgba(255,255,255,.96) 30%);box-shadow:none;padding:24rpx 25rpx calc(16rpx + env(safe-area-inset-bottom))}.cart-bar{height:95rpx;border-radius:52rpx;background:#070707;color:#fff;display:flex;overflow:hidden;justify-content:space-between}.cart-left{display:flex;align-items:center;gap:15rpx;padding-left:24rpx;font-size:29rpx}.cart-symbol{font-size:45rpx}.cart-count{font-size:21rpx;color:#ddd}.cart-caption{font-size:18rpx;color:#aaa}.cart-right{background:#cfcfcf;color:#282828;min-width:205rpx;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:28rpx}

/* Keep both scroll columns inside the viewport on narrow iPhones. */
.menu-layout{overflow:hidden}
.dish-list{flex:1;min-width:0;box-sizing:border-box}

/* Menu cover and feature proportions follow the supplied phone reference. */
.top-banner-frame{height:245rpx}
.shop-info{padding:20rpx 24rpx 0}
.shop-main{min-height:66rpx;gap:12rpx}
.shop-name{font-size:37rpx}
.delivery{font-size:25rpx;margin-left:18rpx}
.chef-entry{flex:none;padding:12rpx 16rpx;font-size:21rpx}
.notice{font-size:23rpx;margin:20rpx 0 27rpx}
.top-links{justify-content:space-between;gap:10rpx;height:73rpx;font-size:24rpx}
.top-links text{font-size:21rpx}
.kitchen-strip{height:305rpx;margin:16rpx 24rpx;background:#fff4dc}
.special-feature{min-height:180rpx;margin:0 24rpx 90rpx;border-radius:18rpx;background:#fff4f6}
.special-feature image{width:174rpx;height:180rpx}
.special-copy{padding:12rpx 16rpx}
.special-kicker{font-size:20rpx}
.special-title{font-size:33rpx;margin:7rpx 0}
.special-desc{font-size:21rpx}
.special-cta{font-size:19rpx;margin-top:8rpx;padding:6rpx 11rpx}

/* Pink menu panel from the supplied phone reference. */
.menu-page{display:flex;flex-direction:column;box-sizing:border-box;min-height:100vh;overflow:visible;background:#fff7f3;padding-bottom:calc(171rpx + env(safe-area-inset-bottom))}
.top-banner,.shop-info,.kitchen-strip,.special-feature{flex:none}
.shop-info{background:#fffdfb}
.shop-name{color:#4f2c30}
.delivery{color:#e58b19}
.chef-entry{background:#fff1d9;color:#a56a42}
.shop-brand{display:flex;flex:1;min-width:0;align-items:center;flex-wrap:wrap;gap:4rpx 0}
.shop-brand .delivery{white-space:nowrap}
.notice{color:#a58c8b}
.top-links{color:#987b80;border-bottom-color:#f6e8e6}
.top-links .current{color:#55343a}
.top-links .current:after{background:#ffc247}
.kitchen-strip{border-radius:16rpx}
.special-feature{margin-bottom:22rpx;border-color:#ffbccd;background:#fff3f6}
.special-cta{border-radius:10rpx}
.menu-layout{display:flex;flex:1 0 auto;width:calc(100% - 36rpx);height:auto;min-height:0;margin:0 18rpx;box-sizing:border-box;overflow:visible;align-items:stretch;border-radius:22rpx;background:#fffdfb;box-shadow:0 8rpx 24rpx rgba(151,75,88,.07)}
.cat-list{flex:0 0 155rpx;width:155rpx;height:auto;min-height:0;background:#fff0ed;border-radius:22rpx 0 0 22rpx}
.cat{min-height:98rpx;gap:4rpx;color:#955d67;border-left-color:transparent;border-radius:0 18rpx 18rpx 0}
.cat-emoji{font-size:30rpx}
.cat.active{background:#fffdfb;border-left-color:#f4557a;color:#542c35}
.dish-list{flex:1 1 0;width:0;min-width:0;height:auto;min-height:0;padding:14rpx 28rpx 12rpx 18rpx;box-sizing:border-box}
.group-title{margin:5rpx 0 4rpx;padding-bottom:12rpx;border-bottom:1rpx solid #f6e8e6;color:#683940;font-size:27rpx;font-weight:900}
.group-heart{margin-left:6rpx;color:#f387a2}
.dish-card{display:flex;width:100%;min-width:0;align-items:flex-start;box-sizing:border-box;min-height:240rpx;border-bottom:1rpx solid #f7e8e5;gap:18rpx;padding:20rpx 0}
.dish-img{width:174rpx;height:194rpx;flex:0 0 174rpx;border-radius:16rpx}
.dish-info{display:flex;flex:1 1 0;width:0;min-width:0;min-height:194rpx;flex-direction:column}
.dish-name{color:#54252f;font-size:28rpx;font-weight:900;line-height:1.25}
.dish-desc{color:#a68688;font-size:20rpx;line-height:1.4;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:8rpx}
.dish-meta{color:#a88d91;font-size:18rpx;line-height:1.4;margin-top:8rpx}
.dish-bottom{display:flex;width:100%;min-width:0;align-items:flex-end;justify-content:space-between;gap:8rpx;margin-top:auto;padding-top:12rpx;box-sizing:border-box}
.dish-price{display:flex;flex:none;min-width:0;flex-direction:column;align-items:flex-start;gap:2rpx;line-height:1}
.price-bolt{color:#f5a342;font-size:22rpx}
.price-number{color:#f24d76;font-size:29rpx;font-weight:900}
.small-add{display:flex;flex:0 0 50%;align-items:center;justify-content:center;box-sizing:border-box;width:50%;max-width:180rpx;min-width:0;height:58rpx;margin:0;padding:0;border:4rpx solid #ffe5e8;border-radius:99rpx;background:linear-gradient(180deg,#ffd2d6,#ffb6c5);color:#743b48;font-size:21rpx;font-weight:800;line-height:1;white-space:nowrap;box-shadow:0 3rpx 8rpx rgba(239,106,137,.16)}
.add-heart{margin-right:6rpx;color:#f4507a;font-size:25rpx;line-height:1}
.sticky-actions{position:fixed;z-index:9;bottom:0;left:0;right:0;padding:6rpx 8rpx env(safe-area-inset-bottom);background:linear-gradient(180deg,rgba(255,247,243,0),#fff0ed 32%);box-shadow:none}
.cart-bar{position:relative;display:block;width:100%;height:165rpx;overflow:hidden;border-radius:42rpx;background:#fff4ef;color:#703d45}
.checkout-art{position:absolute;left:0;top:0;width:100%}
.cart-badge{position:absolute;left:20.5%;top:3rpx;width:49rpx;height:49rpx;display:flex;align-items:center;justify-content:center;border:4rpx solid #fff;border-radius:50%;background:#f34f78;color:#fff;font-size:25rpx;font-weight:900;box-shadow:0 4rpx 10rpx rgba(204,58,93,.25)}
.cart-info{position:absolute;left:28%;top:41rpx;width:34%;min-height:105rpx;padding:6rpx 8rpx;border-radius:20rpx;background:rgba(255,250,246,.97);color:#783c43}
.cart-main{display:flex;align-items:baseline;gap:5rpx;white-space:nowrap;font-size:21rpx;font-weight:900}
.cart-number{color:#ec426c;font-size:37rpx;line-height:1}
.cart-total{margin-left:auto;color:#e87288;font-size:18rpx}
.cart-caption{margin-top:6rpx;color:#c87883;font-size:15rpx;line-height:1.25}
.cart-checkout{position:absolute;right:2%;top:38rpx;width:32%;height:102rpx;display:flex;align-items:center;justify-content:center;border:5rpx solid #ffb0ba;border-radius:99rpx;background:linear-gradient(180deg,#ff8aa0,#f34c71);color:#fff;font-size:31rpx;font-weight:900;text-shadow:0 2rpx 4rpx rgba(154,31,67,.3);box-shadow:0 6rpx 14rpx rgba(224,74,112,.2)}

/* Keep the menu usable below the native navigation bar on shorter phones. */
@media (max-height:850px){
  .special-feature{min-height:140rpx;margin-bottom:12rpx}
  .special-feature image{height:140rpx}
}
@media (max-height:600px){
  .special-feature{min-height:120rpx;margin-bottom:8rpx}
  .special-feature image{height:120rpx}
}

/* Keep the shallow cover while showing more of the characters' heads. */
.top-banner-frame{flex:none;width:100%;overflow:hidden;background:#fff4dc}
.top-banner{position:relative;top:-18rpx;display:block;width:100%;height:auto}
.kitchen-strip{height:auto}

/* The illustrated cart bar has separate review and checkout hit areas. */
.cart-art-hit{position:absolute;z-index:1;left:0;top:0;width:27%;height:100%}
.cart-badge,.cart-info,.cart-checkout{z-index:2}
.cart-checkout-disabled{opacity:.56}

/* Cart bottom sheet. Its list alone scrolls while the menu remains in place. */
.cart-overlay{position:fixed;z-index:20;top:0;right:0;bottom:0;left:0;visibility:hidden;pointer-events:none;transition:visibility 0s .3s}
.cart-overlay-open{visibility:visible;pointer-events:auto;transition:visibility 0s}
.cart-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(27,16,22,.48);opacity:0;transition:opacity .3s ease}
.cart-overlay-open .cart-mask{opacity:1}
.cart-sheet{position:absolute;bottom:0;left:0;right:0;display:flex;flex-direction:column;height:50vh;max-height:85vh;overflow:hidden;border-radius:34rpx 34rpx 0 0;background:#fff7f3;color:#63343e;box-shadow:0 -14rpx 40rpx rgba(71,29,43,.2);transform:translateY(100%);transition:transform .3s ease;padding-bottom:env(safe-area-inset-bottom)}
.cart-sheet-expanded{height:85vh}
.cart-overlay-open .cart-sheet{transform:translateY(0)}
.cart-sheet-head{position:relative;flex:none;padding:9rpx 28rpx 18rpx;text-align:center;background:linear-gradient(180deg,#ffe9ee,#fff7f3)}
.cart-sheet-handle{width:76rpx;height:8rpx;margin:0 auto 17rpx;border-radius:99rpx;background:#eab4c2}
.cart-sheet-title{font-size:30rpx;font-weight:900;color:#653341}
.cart-sheet-title text{color:#f34f78}
.cart-sheet-close{position:absolute;right:25rpx;top:26rpx;display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%;background:#fff;color:#bd7889;font-size:40rpx;line-height:1}
.cart-sheet-list{flex:1;height:0;min-height:0;padding:0 24rpx;box-sizing:border-box}
.cart-sheet-empty{padding:55rpx 20rpx;text-align:center;color:#aa7d8b;font-size:23rpx}
.cart-sheet-empty .empty-icon{margin-bottom:10rpx}
.cart-sheet-line{display:flex;align-items:center;gap:16rpx;padding:17rpx 0;border-bottom:2rpx dashed #f1dce2}
.cart-sheet-line image{flex:none;width:118rpx;height:118rpx;border-radius:17rpx;background:#fff1f3}
.cart-sheet-item{flex:1;min-width:0}
.cart-sheet-name{font-size:25rpx;font-weight:900;color:#65343f;overflow-wrap:break-word}
.cart-sheet-type{margin:7rpx 0;color:#a5838d;font-size:19rpx}
.cart-sheet-price{color:#ef5d7e;font-size:22rpx;font-weight:900}
.cart-sheet-actions{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:17rpx}
.cart-sheet-remove{padding:5rpx 0;color:#a68b93;font-size:20rpx}
.cart-sheet-counter{display:flex;align-items:center;gap:13rpx;color:#65343f;font-size:24rpx;font-weight:800}
.cart-sheet-counter text:first-child,.cart-sheet-counter text:last-child{display:flex;align-items:center;justify-content:center;width:43rpx;height:43rpx;border-radius:50%;background:#ffd5df;color:#a64e69;font-size:27rpx}
.cart-sheet-foot{flex:none;display:flex;align-items:center;justify-content:space-between;gap:15rpx;padding:18rpx 25rpx 16rpx;border-top:2rpx solid #f6dfe5;background:#fffdfb}
.cart-sheet-sum{display:flex;flex-direction:column;gap:5rpx;color:#ef5d7e;font-size:27rpx;font-weight:900}
.cart-sheet-sum text:last-child{color:#aa8790;font-size:19rpx;font-weight:400}
.cart-sheet-submit{flex:none;margin:0;padding:18rpx 26rpx;border-radius:99rpx;background:linear-gradient(180deg,#ff9caf,#f4587d);color:#fff;font-size:24rpx;font-weight:900;line-height:1.2}
.cart-sheet-submit[disabled]{opacity:.55}

/* Decorative love meter fits beside the existing feature copy. */
.special-copy{flex:1 1 0;width:0;min-width:0;padding-right:8rpx}
.special-kicker,.special-title,.special-desc,.special-cta{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.love-energy{flex:0 0 154rpx;width:154rpx;min-width:0;margin-right:12rpx;padding:9rpx 10rpx 8rpx;box-sizing:border-box;border:2rpx solid #ffd7e1;border-radius:18rpx;background:linear-gradient(145deg,#fffafd,#ffeaf1);text-align:center;color:#b75b78}
.love-energy-label,.love-energy-caption{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.25}
.love-energy-label{font-size:18rpx;font-weight:700}
.love-energy-value{display:flex;align-items:center;justify-content:center;gap:5rpx;margin:4rpx 0;color:#ed5b83;font-size:32rpx;font-weight:900;line-height:1.2;white-space:nowrap}
.love-energy-heart{display:inline-block;font-size:26rpx;animation:love-energy-heartbeat 2.4s ease-in-out infinite}
.love-energy-track{height:9rpx;overflow:hidden;border-radius:99rpx;background:#ffe0e9}
.love-energy-fill{width:99%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#ffb9cf,#f56b99);transform-origin:left center;animation:love-energy-grow 1.1s ease-out both}
.love-energy-caption{margin-top:6rpx;font-size:18rpx;font-weight:800}
@keyframes love-energy-heartbeat{0%,100%{transform:scale(1)}12%{transform:scale(1.12)}24%{transform:scale(1)}36%{transform:scale(1.08)}48%{transform:scale(1)}}
@keyframes love-energy-grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media (max-height:600px){.love-energy{padding-top:5rpx;padding-bottom:5rpx}.love-energy-value{margin:2rpx 0;font-size:28rpx}.love-energy-caption{margin-top:3rpx}}
