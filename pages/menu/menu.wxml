<view class="page menu-page">
  <image class="top-banner" src="/assets/images/shinchan-kitchen.jpg" mode="aspectFill"/>
  <view class="shop-info">
    <view class="shop-main"><view><text class="shop-name">小霞饱饱食堂</text><text class="delivery">⚡ 闪电专送</text></view><view class="chef-entry" bindtap="goChef" catchlongpress="diagnoseCloud">👨‍🍳 主厨入口 ›</view></view>
    <view class="notice">🔊 fxx专属食堂 闪电目标喂饱宝宝</view>
    <view class="top-links"><view class="current">菜单 <text>({{menuCount}})</text></view><view bindtap="goRandom">今天吃什么</view><view bindtap="goFavorites">♡ 收藏</view><view bindtap="goOrders">订单</view></view>
  </view>
  <image class="kitchen-strip" src="/assets/images/kitchen-strip.jpg" mode="aspectFill"/>
  <view class="special-feature" bindtap="detail" data-id="special-love"><image src="/assets/images/shinchan-love.jpg" mode="aspectFill"/><view class="special-copy"><view class="special-kicker">💗 女朋友专属 · 无限供应</view><view class="special-title">可亲可抱可爱爱</view><view class="special-desc">主厨限定，甜蜜不限量</view><view class="special-cta">立即召唤闪电 ⚡</view></view></view>
  <view class="menu-layout"><scroll-view class="cat-list" scroll-y="true"><view wx:for="{{categories}}" wx:key="id" class="cat {{selected===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tapCategory"><text class="cat-emoji">{{item.emoji}}</text><text>{{item.short}}</text></view></scroll-view><scroll-view class="dish-list" scroll-y="true"><view class="group-title">{{selectedName}}</view><view wx:for="{{visible}}" wx:key="id" class="dish-card"><image class="dish-img" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="detail"/><view class="dish-info" data-id="{{item.id}}" bindtap="detail"><view class="dish-name">{{item.name}}</view><view class="dish-desc">{{item.description}}</view><view class="dish-meta" wx:if="{{item.type==='dish'}}">{{item.minutes}} 分钟 · {{item.difficulty}} 星难度</view><view class="dish-meta" wx:else>女朋友专属 · 无限供应</view><view class="dish-bottom"><text class="price">⚡ {{item.price}}</text><button class="small-add" data-id="{{item.id}}" catchtap="add">点它</button></view></view></view></scroll-view></view>
  <view class="sticky-actions"><view class="cart-bar" bindtap="goCart"><view class="cart-left"><text class="cart-symbol">🛒</text><view><view>⚡ {{total}} <text class="cart-count">· {{cartCount}} 件</text></view><view class="cart-caption">View Cart</view></view></view><view class="cart-right">去结算</view></view></view>
</view>
