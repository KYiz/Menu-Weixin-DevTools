.random-page{padding:24rpx 24rpx calc(70rpx + env(safe-area-inset-bottom));background:#fff7f3;color:#63343e}
.random-top{padding:30rpx 24rpx;margin-bottom:22rpx;border:2rpx solid #ffd6df;border-radius:24rpx;background:linear-gradient(135deg,#fff1f4,#ffe5ea);text-align:center}
.random-icon{width:82rpx;height:82rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 10rpx;border-radius:50%;background:#fffdfb;font-size:44rpx;box-shadow:0 5rpx 14rpx rgba(218,108,138,.12)}
.random-title{color:#653341;font-size:38rpx;font-weight:900}
.random-top text{display:block;margin-top:8rpx;color:#a87583;font-size:22rpx}
.draw-card{padding:20rpx;border:2rpx solid #fbe0e6;border-radius:24rpx;background:#fffdfb;text-align:center;box-shadow:0 8rpx 24rpx rgba(151,75,88,.07)}
.draw-card image{display:block;width:100%;height:390rpx;border-radius:17rpx;background:#fff1f3}
.draw-card .pill{margin-top:20rpx;background:#ffe9ef;color:#ca6682;font-weight:800}
.picked-name{margin:16rpx 0 8rpx;color:#65343f;font-size:38rpx;font-weight:900}
.picked-desc{color:#a5838d;font-size:22rpx;line-height:1.5}
.picked-meta{margin:21rpx 0;color:#bf7b8c;font-size:22rpx}
.random-actions{display:flex;gap:14rpx}
.random-actions .btn{flex:1;min-width:0;padding:17rpx 10rpx;font-size:23rpx}
.random-actions .btn-light{border:2rpx solid #f7d3dc;background:#fff3f6;color:#a35b70}
.random-actions .random-add{border:2rpx solid #ffb2c3;background:linear-gradient(180deg,#ff9caf,#f4587d);color:#fff}
.open{padding:23rpx 0 5rpx;color:#d46280;font-size:22rpx;font-weight:800}
.foot{margin-top:25rpx;color:#b48d98;text-align:center;font-size:21rpx}
.random-page .empty{border:2rpx dashed #f5cad4;border-radius:22rpx;background:#fffdfb;color:#aa7d8b}
