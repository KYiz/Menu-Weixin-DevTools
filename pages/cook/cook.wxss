.cook-page{padding:30rpx 24rpx 160rpx}.cook-heading{text-align:center;margin:15rpx 0 30rpx}.kicker{font-size:22rpx;color:#d18842;font-weight:800}.cook-name{font-size:39rpx;font-weight:900;margin:10rpx}.cook-heading .muted{font-size:21rpx}.progress-track{height:13rpx;background:#f3e5d0;border-radius:99rpx;overflow:hidden;margin-bottom:25rpx}.progress-track view{height:100%;background:#ffc533;border-radius:99rpx}.current{padding:30rpx}.step-count{display:inline-block;background:#fff0ca;color:#b77732;border-radius:99rpx;padding:8rpx 18rpx;font-size:22rpx;font-weight:800}.current-title{font-size:42rpx;font-weight:900;margin:25rpx 0}.current-text{font-size:28rpx;line-height:1.75;color:#5f4b3e}.current-detail{margin:30rpx 0;background:#fff8e9;border-radius:18rpx;padding:10rpx 20rpx}.current-detail>view{border-bottom:2rpx dashed #efdfca;padding:17rpx 0}.current-detail>view:last-child{border:0}.current-detail text{font-size:21rpx;color:#b08561}.current-detail view view{font-size:25rpx;font-weight:800;margin-top:7rpx}.timer{display:flex;align-items:center;justify-content:space-between;border-top:2rpx dashed #eadcc7;padding-top:25rpx}.timer view{font-size:37rpx;font-weight:900;color:#dc8042}.timer .btn{font-size:22rpx}.step-actions{display:flex;gap:15rpx}.step-actions .btn{flex:1;font-size:24rpx}.step-actions .btn[disabled]{opacity:.45}.done-card{text-align:center;padding:65rpx 30rpx}.done-icon{font-size:75rpx}.done-title{font-size:45rpx;font-weight:900;margin:15rpx}.plating{background:#fff0d6;padding:25rpx;border-radius:19rpx;margin:32rpx 0;color:#88674c}.done-card .btn{width:100%}
