<view class="page cook-page" wx:if="{{recipe}}"><view class="cook-heading"><view class="kicker">⚡ 闪电主厨进行中</view><view class="cook-name">{{item.name}}</view><view class="muted">{{servings}} 人份 · 记得留意锅里的变化</view></view><view class="progress-track"><view style="width:{{progress}}%"></view></view><view wx:if="{{!done}}" class="current cream-card"><view class="step-count">第 {{index+1}} / {{recipe.steps.length}} 步</view><view class="current-title">{{step.title}}</view><view class="current-text">{{step.text}}</view><view class="current-detail"><view><text>🥕 这步用到</text><view>{{step.uses}}</view></view><view><text>🔥 火候</text><view>{{step.heat}}</view></view><view><text>⏱ 参考时间</text><view>约 {{step.minutes}} 分钟</view></view></view><view class="timer"><view>⏲ {{clock}}</view><button class="btn btn-light" bindtap="toggleTimer">{{running?'暂停计时':'开始计时'}}</button></view></view><view wx:else class="done-card cream-card"><view class="done-icon">⚡🍽️</view><view class="done-title">闪电出餐！</view><view class="muted">把好吃的端给最喜欢的人吧 💛</view><view class="plating">{{recipe.plating}}</view><button class="btn" bindtap="backRecipe">返回菜谱</button></view><view wx:if="{{!done}}" class="sticky-actions"><view class="step-actions"><button class="btn btn-light" disabled="{{index===0}}" bindtap="prev">← 上一步</button><button class="btn" bindtap="next">{{index===recipe.steps.length-1?'完成出餐 ⚡':'下一步 →'}}</button></view></view></view>
