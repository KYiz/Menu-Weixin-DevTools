.cover{width:100%;height:520rpx;background:#ffefd1}.detail-body{position:relative;margin-top:-28rpx;background:#fffaf0;border-radius:32rpx 32rpx 0 0;padding:35rpx 30rpx}.headline{display:flex;justify-content:space-between;align-items:center}.kicker{font-size:22rpx;color:#e27e48;font-weight:800}.name{font-size:45rpx;font-weight:900;margin-top:8rpx}.heart{font-size:48rpx;padding:10rpx}.desc{color:#806b5e;line-height:1.7;margin:20rpx 0}.tags{display:flex;flex-wrap:wrap;gap:12rpx}.tag{padding:10rpx 18rpx;border-radius:99rpx;background:#ffedc6;color:#9a6a2f;font-size:22rpx}.tag.pink{background:#ffe1e8;color:#c75d7c}.love-note{background:#fff0f3;border:2rpx dashed #ffb2c6;color:#a94768;border-radius:25rpx;text-align:center;font-size:30rpx;font-weight:700;padding:38rpx;margin-top:32rpx}.love-note view{font-size:23rpx;margin-top:14rpx}.recipe-link{margin-top:35rpx;padding:28rpx;display:flex;justify-content:space-between;align-items:center;color:#aa6d35}.recipe-link .muted{font-size:22rpx;margin-top:8rpx}.detail-tip{color:#aa9587;text-align:center;font-size:22rpx;margin:35rpx 0}.detail-actions{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.detail-actions .btn{font-size:24rpx;padding:19rpx 25rpx;white-space:nowrap}.bottom-price{color:#ef7a3e;font-weight:900;font-size:31rpx}.bottom-price text{display:block;font-size:20rpx;color:#aa9687;font-weight:400}.cart-link{font-size:38rpx}
