.cover{width:100%;height:520rpx;background:#ffefd1}.detail-body{position:relative;margin-top:-28rpx;background:#fffaf0;border-radius:32rpx 32rpx 0 0;padding:35rpx 30rpx}.headline{display:flex;justify-content:space-between;align-items:center}.kicker{font-size:22rpx;color:#e27e48;font-weight:800}.name{font-size:45rpx;font-weight:900;margin-top:8rpx}.heart{font-size:48rpx;padding:10rpx}.desc{color:#806b5e;line-height:1.7;margin:20rpx 0}.tags{display:flex;flex-wrap:wrap;gap:12rpx}.tag{padding:10rpx 18rpx;border-radius:99rpx;background:#ffedc6;color:#9a6a2f;font-size:22rpx}.tag.pink{background:#ffe1e8;color:#c75d7c}.love-note{background:#fff0f3;border:2rpx dashed #ffb2c6;color:#a94768;border-radius:25rpx;text-align:center;font-size:30rpx;font-weight:700;padding:38rpx;margin-top:32rpx}.love-note view{font-size:23rpx;margin-top:14rpx}.recipe-link{margin-top:35rpx;padding:28rpx;display:flex;justify-content:space-between;align-items:center;color:#aa6d35}.recipe-link .muted{font-size:22rpx;margin-top:8rpx}.detail-tip{color:#aa9587;text-align:center;font-size:22rpx;margin:35rpx 0}.detail-actions{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.detail-actions .btn{font-size:24rpx;padding:19rpx 25rpx;white-space:nowrap}.detail-actions .special-video-btn{flex:1}.bottom-price{color:#ef7a3e;font-weight:900;font-size:31rpx}.bottom-price text{display:block;font-size:20rpx;color:#aa9687;font-weight:400}.cart-link{font-size:38rpx}

/* The special-service detail panel follows the menu page's soft pink card style. */
.special-detail{background:#fff7f3}
.special-detail .detail-body{min-height:calc(100vh - 492rpx);box-sizing:border-box;background:#fffdfb;box-shadow:0 -6rpx 20rpx rgba(151,75,88,.07)}
.special-detail .kicker{color:#cf6984}
.special-detail .name{color:#542c35}
.special-detail .desc{color:#a68688}
.special-detail .tag.pink{background:#ffe5ed;color:#bd5f7b}
.special-detail .love-note{background:#fff3f6;border:2rpx solid #ffbccd;border-radius:22rpx;color:#a94768;box-shadow:0 8rpx 24rpx rgba(151,75,88,.07)}
.special-detail .detail-tip{color:#a58c8b}
.special-detail .detail-actions{background:#fff7f3;box-shadow:0 -8rpx 24rpx rgba(151,75,88,.08)}
.special-detail .special-video-btn{background:linear-gradient(180deg,#ff8aa0,#f34c71);color:#fff;box-shadow:0 6rpx 14rpx rgba(224,74,112,.2)}
