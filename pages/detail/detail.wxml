<view class="page {{item.type==='special_service'?'special-detail':''}}" wx:if="{{item}}"><image class="cover" src="{{item.image}}" mode="aspectFill"/><view class="detail-body"><view class="headline"><view><view class="kicker">{{item.type==='special_service'?'💗 情侣专属服务':'⚡ 闪电主厨手作'}}</view><view class="name">{{item.name}}</view></view><view class="heart" bindtap="toggle">{{liked?'❤️':'🤍'}}</view></view><view class="desc">{{item.description}}</view><view class="tags" wx:if="{{item.type==='special_service'}}"><text wx:for="{{item.tags}}" wx:key="*this" class="tag pink">{{item}}</text></view><view class="tags" wx:else><text class="tag">⭐ {{item.difficulty}} 星难度</text><text class="tag">⏱ 约 {{item.minutes}} 分钟</text><text class="tag">👩‍❤️‍👨 2 人份</text></view><view class="love-note" wx:if="{{item.type==='special_service'}}">“今天也有一份偏爱，随叫随到。”<view>💌 0 ⚡ 闪电币，快乐无价</view></view><view class="recipe-link cream-card" wx:else bindtap="recipe"><view><view class="section-title">📒 完整菜谱</view><view class="muted">食材、用量、火候与每一步都写好啦</view></view><text>查看 →</text></view><view class="detail-tip">{{item.type==='special_service'?'确认后将返回微信，你可以手动发起视频通话。':'喜欢就点一份，主厨等你派单。'}}</view></view><view class="sticky-actions detail-actions"><view class="bottom-price" wx:if="{{item.type!=='special_service'}}">⚡ {{item.price}}<text> · 已选 {{qty}} 份</text></view><button class="btn special-video-btn" wx:if="{{item.type==='special_service'}}" bindtap="openWechatVideo">打开微信视频</button><button class="btn" wx:else bindtap="add">加入小餐车 +</button><view class="cart-link" wx:if="{{item.type!=='special_service'}}" bindtap="cart">🛒</view></view></view>
