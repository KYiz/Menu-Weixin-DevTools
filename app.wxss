page{background:#fffaf0;color:#493b31;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{border:0}button::after{border:0}.page{min-height:100vh;padding-bottom:150rpx}.cream-card{background:#fff;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(126,83,41,.08)}.pill{display:inline-flex;align-items:center;background:#fff0cf;color:#a76320;border-radius:99rpx;padding:8rpx 18rpx;font-size:22rpx}.btn{background:#ffd44f;color:#513a20;border-radius:99rpx;font-weight:700;line-height:1.2;padding:20rpx 32rpx;font-size:28rpx}.btn-pink{background:#ff8da6;color:#fff}.btn-light{background:#fff4d5;color:#8a5923}.muted{color:#9b8e83}.price{color:#f27838;font-weight:800}.section-title{font-size:34rpx;font-weight:800}.sticky-actions{position:fixed;bottom:0;left:0;right:0;background:#fffaf0;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 24rpx rgba(76,45,17,.1);z-index:5}.empty{text-align:center;padding:90rpx 30rpx;color:#a3907d}.empty-icon{font-size:80rpx;display:block;margin-bottom:14rpx}
